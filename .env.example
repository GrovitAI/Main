# Copy to .env and fill in. Never commit .env.
# ── Client (bundled into the app; safe to expose = anon key only) ──
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: API origin for native builds (web uses window.location.origin)
EXPO_PUBLIC_API_BASE_URL=https://dinein.grovit.com

# ── Server only (Vercel project environment; NEVER prefix with EXPO_PUBLIC_) ──
PRINTNODE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=https://dinein.grovit.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Grovit POS <no-reply@example.com>"
